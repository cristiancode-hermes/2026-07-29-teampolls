{
  "name": "teampolls",
  "version": "1.0.0",
  "private": true,
  "description": "TeamPolls — Team polling and decision-making platform",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build:api": "cd apps/api && ../../node_modules/.bin/tsc",
    "build:web": "cd apps/web && ../../node_modules/.bin/ng build",
    "build": "npm run build:api && npm run build:web",
    "seed": "cross-env SEED_DB=true node apps/api/dist/main.js"
  },
  "dependencies": {
    "zone.js": "^0.16.2"
  }
}
